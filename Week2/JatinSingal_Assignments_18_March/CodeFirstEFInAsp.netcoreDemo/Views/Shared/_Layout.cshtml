<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Neon Crew Studio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CodeFirstEFInAsp.netcoreDemo.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="page-shell">
        <div class="floating-orb orb-one"></div>
        <div class="floating-orb orb-two"></div>
        <div class="floating-orb orb-three"></div>
        <div class="grid-glow"></div>
        <div class="spotlight"></div>

        <header class="site-header">
            <nav class="navbar navbar-expand-lg site-nav">
                <div class="container">
                    <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-icon">NC</span>
                        <span>
                            <strong>Neon Crew</strong>
                            <small>Cartoon HR Dashboard</small>
                        </span>
                    </a>

                    <button class="navbar-toggler nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="displayemp">Crew</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Create">Add Member</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Transaction" asp-action="CreateCustomer">Buy Product</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="site-main">
            <div class="container">
                @RenderBody()
            </div>
        </main>

        <footer class="site-footer">
            <div class="container footer-content">
                <p>Neon Crew Studio keeps your employee flow glowing, animated, and organized.</p>
                <a asp-area="" asp-controller="Home" asp-action="displayemp">View Crew Board</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
