@model IEnumerable<DBFirstEFinASpCOreDemo.Models.CustomerVM>

@{
    ViewData["Title"] = "SpainCustomers";
}

<h1>Spain Customers</h1>

<table class="table">
    <thead>
        <tr>
            <th>Customer ID</th>
            <th>Contact Name</th>
            <th>Company Name</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerId</td>
                <td>@item.ContactName</td>
                <td>@item.CompanyName</td>
            </tr>
        }
    </tbody>
</table>