@model List<string>

@{
    ViewData["Title"] = "Containers";
}

<br />
<br />
<div class="border bg-white p-4">
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-warning">@errorMessage</div>
    }
    <div class="row">
        <div class="col-6">
            <h2 class="text-info">Container List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Create" class="btn btn-info text-white">Create New</a>
        </div>
    </div>
    <br />
    <div>
        @if (Model != null && Model.Count > 0)
        {
            <table class="table table-striped border">
                <tr class="table-secondary">
                    <th>
                        Container Name
                    </th>
                    <th></th>
                </tr>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item
                        </td>
                        <td>
                            <a class="btn btn-primary text-white" asp-action="Manage" asp-controller="Blob" asp-route-containerName="@item">
                                Manage
                            </a>
                            <a class="btn btn-danger text-white" asp-action="Delete" asp-route-containerName="@item">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </table>
        }
        else
        {
            <p>No containers exist yet.</p>
        }
    </div>
</div>
