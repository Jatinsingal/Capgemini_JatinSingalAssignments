@model Dog_App.Models.Dog

@{
    ViewData["Title"] = "Create";
}

<div class="dog-form-shell">
    <div class="dog-form-header">
        <h1 class="mb-2">Create Dog</h1>
        <p class="text-muted mb-0">Add a new dog profile with clean details and a great photo.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="dog-form-card">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="dog-form-note">
                        Dog ID will be created automatically when you save.
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="control-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control dog-input" placeholder="Enter dog name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Age" class="control-label fw-semibold"></label>
                        <input asp-for="Age" class="form-control dog-input" placeholder="Enter age" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control dog-textarea" rows="5" placeholder="Share the dog's personality, habits, and anything special"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label class="control-label fw-semibold">Dog Image</label>
                        <input type="file" name="imagefile" class="form-control dog-input" />
                    </div>

                    <div class="dog-form-actions">
                        <button type="submit" class="btn dog-primary-btn">Save Dog</button>
                        <a asp-action="Index" class="btn dog-secondary-btn">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
