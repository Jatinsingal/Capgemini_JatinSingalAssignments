@model IEnumerable<Dog_App.Models.Dog>

@{
    ViewData["Title"] = "Index";
}

<section class="dog-gallery-hero mb-4">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-8">
            <div class="dog-gallery-main">
                <span class="dog-panel-kicker">Dog Gallery</span>
                <h1 class="mb-2">Explore glowing dog profiles in one place.</h1>
                <p class="text-muted mb-4">Create, review, and manage every dog profile with a premium neon dashboard feel.</p>

                <div class="dog-home-actions">
                    <a asp-action="Create" class="btn dog-primary-btn">Create New</a>
                    <a asp-controller="Home" asp-action="Index" class="btn dog-secondary-btn">Back Home</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dog-gallery-side">
                <div class="dog-mini-stat">
                    <span class="dog-mini-stat-label">Profiles</span>
                    <span class="dog-mini-stat-value">@Model.Count()</span>
                </div>
                <div class="dog-mini-stat">
                    <span class="dog-mini-stat-label">Search Mode</span>
                    <span class="dog-mini-stat-value">@(!string.IsNullOrWhiteSpace(ViewBag.Search as string) ? "On" : "All")</span>
                </div>
            </div>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
{
    <div class="alert alert-light border mb-4">
        Showing results for <strong>@ViewBag.Search</strong>.
    </div>
}

<div class="table-responsive dog-table-shell">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Age)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Description)
                </th>
                <th>
                    Image
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.ID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Age)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                            {
                                <img src="@item.ImagePath" alt="@item.Name" width="120" height="120" class="dog-table-image" />
                            }
                            else
                            {
                                <span class="text-muted">No image</span>
                            }
                        </td>
                        <td>
                            <div class="dog-table-actions">
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn dog-table-btn">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn dog-table-btn">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.ID" class="btn dog-table-btn dog-table-btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">No dogs found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
